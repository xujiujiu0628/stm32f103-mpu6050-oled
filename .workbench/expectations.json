{
  "version": "1.0",
  "expectations": [
    {
      "id": "FR-BOOT-01",
      "desc": "上电输出启动横幅",
      "texts": [
        "[BOOT] stm32f103-mpu6050-oled v0.1"
      ]
    },
    {
      "id": "FR-BOOT-02",
      "desc": "启动横幅含重校准提示行（PB15 长按）",
      "texts": [
        "[BOOT] PB15 long = recalibrate gyro"
      ]
    },
    {
      "id": "FR-BRT-01",
      "desc": "亮度模块评估心跳输出档位行（滞回引擎在跑，1Hz）",
      "texts": [
        "[BRT] band="
      ]
    },
    {
      "id": "FR-MPU-01",
      "desc": "MPU6050 探测成功（地址 0x68 或 0x69）",
      "patterns": [
        "\\[BOOT\\] MPU6050 OK @ 0x6[89]"
      ]
    },
    {
      "id": "FR-MPU-02",
      "desc": "周期性 6 轴数据行（100ms 周期）",
      "patterns": [
        "\\[STATE=\\d+ last=\\d+\\] ax=-?\\d+\\.\\d\\d ay=-?\\d+\\.\\d\\d az=-?\\d+\\.\\d\\d gx=-?\\d+\\.\\d gy=-?\\d+\\.\\d gz=-?\\d+\\.\\d"
      ],
      "forbidden_patterns": [
        "\\[DIAG\\] MPU6050_UpdateEuler FAIL"
      ],
      "xfail": false
    },
    {
      "id": "FR-MPU-03",
      "desc": "静止时加速度 az 应在 0.8-1.2g 范围（重力归一化）",
      "patterns": [
        "az=(-?\\d+\\.\\d\\d)"
      ],
      "capture_group": 1,
      "min": 0.5,
      "max": 1.5,
      "xfail": false
    },
    {
      "id": "FR-OLED-01",
      "desc": "RTT 周期行含状态字段（OLED 10Hz 显示状态机）",
      "texts": [
        "[STATE="
      ]
    },
    {
      "id": "FR-KEY-01",
      "desc": "短按事件输出（用户按 1 次）",
      "texts": [
        "[KEY] SHORT"
      ]
    },
    {
      "id": "FR-KEY-02",
      "desc": "长按事件输出（用户按 1 次）",
      "texts": [
        "[KEY] LONG"
      ]
    },
    {
      "id": "FR-CAL-01",
      "desc": "PB15 长按触发陀螺仪重校准（XPASS 翻转: 用户自持窗实测 [CAL] done）",
      "texts": [
        "[CAL] done"
      ]
    },
    {
      "id": "FR-OLED-02",
      "desc": "关屏后无周期性 RTT 数据（节流验证）",
      "texts": [
        "[STATE=3 last="
      ]
    },
    {
      "id": "FR-SAFE-01",
      "desc": "boot 在场且禁 HardFault/错误处理器指纹（正负成对，正锚借 boot）",
      "texts": [
        "[BOOT] stm32f103-mpu6050-oled v0.1"
      ],
      "forbidden_texts": ["HARDFAULT", "HardFault", "Error handler"]
    },
    {
      "id": "NFR-01",
      "desc": "性能：steady-state 1s 窗口采样 >=90Hz 且单次刷屏阻塞 <10ms（分片刷；回退整帧刷即判红）",
      "patterns": [
        "mpu n=(\\d+) avg=\\d+\\.\\dms max_ms=\\d+ late=0",
        "max_us=\\d{1,4}\\b"
      ],
      "capture_group": 1,
      "min": 90
    },
    {
      "id": "FR-IR-01",
      "desc": "红外接收初始化，启动日志标明引脚",
      "texts": [
        "[IR] init pin=PB6"
      ]
    },
    {
      "id": "FR-IR-02",
      "desc": "每个 NEC 帧打印地址/命令/原始值",
      "patterns": [
        "\\[IR\\] addr=0x[0-9A-F]{2} cmd=0x[0-9A-F]{2} raw=0x[0-9A-F]{8}"
      ]
    },
    {
      "id": "FR-IR-03",
      "desc": "MODE 键双向切换（采集窗内按两次）",
      "texts": [
        "[IR] mode=IR",
        "[IR] mode=MPU"
      ]
    },
    {
      "id": "FR-IR-04",
      "desc": "IR 模式下旋转与硬降动作（采集窗内各按一次）",
      "texts": [
        "[IR] rotate",
        "[IR] harddrop rows="
      ]
    }
  ],
  "waived": [
    { "id": "FR-DISP-02", "reason": "10Hz 刷新率系屏上视觉/示波器测量, RTT 不可见",
      "evidence": "docs/FSD.md#FR-DISP-02", "owner": "maintainer", "date": "2026-09-11" },
    { "id": "FR-OLED-03", "reason": "4 页显示内容为视觉观察项; 状态字段侧有 FR-OLED-01/02 断言",
      "evidence": "docs/FSD.md#FR-OLED-03", "owner": "maintainer", "date": "2026-09-11" },
    { "id": "FR-KEY-03", "reason": "状态机切换需真人按键时序, 断言在采集窗内不稳定; 真机物理测试已验",
      "evidence": ".workbench/releases/v0.5.json", "owner": "maintainer", "date": "2026-09-11" },
    { "id": "FR-PWR-01", "reason": "关屏黑屏为视觉观察; 后台续跑由 FR-OLED-02 断言部分覆盖",
      "evidence": ".workbench/releases/v0.5.json", "owner": "maintainer", "date": "2026-09-11" },
    { "id": "FR-PWR-02", "reason": "唤醒回原页为物理按键序列验证",
      "evidence": ".workbench/releases/v0.5.json", "owner": "maintainer", "date": "2026-09-11" },
    { "id": "FR-BRT-02", "reason": "滞回阈值正确性主体在 host tier（哨兵单测 21 例），verify 面由 FR-BRT-01 心跳 + FR-BRT-03 人工档变观察覆盖",
      "evidence": "tests/test_brt_band.c", "owner": "maintainer", "date": "2026-09-12" },
    { "id": "FR-BRT-03", "reason": "变档 ≤100ms 亮度可察觉变化为人工目测；无周期刷屏占用由 FR-BRT-01 心跳频率断言侧面钉",
      "evidence": "docs/FSD.md#FR-BRT-03", "owner": "maintainer", "date": "2026-09-12" },
    { "id": "FR-CAL-02", "reason": "覆盖层出现/撤销为人工目测；'校准期间禁止穿插刷屏'为代码结构约束（OledView_ShowCalibHint 先刷后采样），fresh-checker 审读面",
      "evidence": "docs/FSD.md#FR-CAL-02", "owner": "maintainer", "date": "2026-09-12" }
  ]
}
